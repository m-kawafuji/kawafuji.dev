---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { compareDesc } from "date-fns";

import BlogEntryCard from "../components/BlogEntryCard.astro";
import Container from "../components/Container.astro";
import GlobalLayout from "../layouts/GlobalLayout.astro";

const blogCollection = (await getCollection("blog")).toSorted((a, b) =>
  compareDesc(a.data.date, b.data.date),
);
---

<GlobalLayout title="Masashi Kawafuji" description="Masashi Kawafuji's blog">
  <main>
    <Container>
      <section class="py-8 text-center">
        <h1 class="bg-radial-[closest-side,rgb(255_255_255/25%),rgb(115_115_255/0%)] py-16 font-brand text-5xl wrap-anywhere text-[#ffdd6e] text-shadow-[0.08em_0.08em_rgb(225_15_19/80%)]">
          Masashi Kawafuji
        </h1>
        <p class="-mt-4">
          This is my personal blog where
          <br />I mainly write about web development.
        </p>
      </section>

      <section class="py-16">
        <h2 class="mx-auto w-fit text-center font-brand text-4xl">Posts</h2>
        <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(min(20rem,100%),1fr))] gap-6">
          {blogCollection.map((blogEntry) => (
            <BlogEntryCard blogEntry={blogEntry} />
          ))}
        </div>
      </section>
    </Container>
  </main>
</GlobalLayout>
